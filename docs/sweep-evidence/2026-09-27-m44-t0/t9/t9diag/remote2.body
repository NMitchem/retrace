log enable -f @D@/@TAG@.packets gdb-remote packets
breakpoint set -a 0x100000530
process continue
thread step-inst
register read fp lr sp pc
process plugin packet send m27ff7b0,10
script print("MEMREAD-BEGIN")
script lldb.debugger.HandleCommand("memory read -c 16 0x27ff7b0")
script err = lldb.SBError(); v = lldb.process.ReadUnsignedFromMemory(0x27ff7b8, 8, err); print("SB read [0x27ff7b8]:", hex(v), "error:", err.GetCString())
script err = lldb.SBError(); v = lldb.process.ReadUnsignedFromMemory(0xfffffff8, 8, err); print("SB read [0xfffffff8]:", hex(v), "error:", err.GetCString())
script err = lldb.SBError(); v = lldb.process.ReadUnsignedFromMemory(0x100000000, 4, err); print("SB read [0x100000000]:", hex(v), "error:", err.GetCString())
script print("MEMREAD-END")
log enable -v -f @D@/@TAG@.unwind lldb unwind
bt
