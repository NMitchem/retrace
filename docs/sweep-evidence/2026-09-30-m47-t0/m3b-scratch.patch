--- a/crates/retrace-core/src/lib.rs
+++ b/crates/retrace-core/src/lib.rs
@@ -406,6 +406,46 @@ fn record_box(mut b: Box_, trace_path: &Path) -> Result<RecordSummary, String> {
                 w.append(&Event::Syscall { num, args, ret: 0, ret1: 0, err: false, writes: writes.clone(), thread }).map_err(|e| format!("append mac_syscall: {e}"))?; count += 1;
                 b.apply_and_return(0, false, &writes);
             }
+            // M47 t0 M3(b) SCRATCH (never committed): fork (2) refused with EAGAIN, carry set, no
+            // writes, never forwarded.
+            Stop::Syscall { num, args } if num == 2 => {
+                eprintln!("[m47-scratch] fork (2) refused EAGAIN");
+                w.append(&Event::Syscall { num, args, ret: 35, ret1: 0, err: true, writes: vec![], thread }).map_err(|e| format!("append fork: {e}"))?; count += 1;
+                b.set_x0_err_and_return(35, true);
+            }
+            // PROBE SCRATCH (not for main): __mac_syscall("AMFI", 0x5a, {inFlags, &outFlags}) —
+            // the kernel writes through the NESTED outFlags pointer, a guest VA that is unmapped in
+            // retrace's own space, so the generic forward EFAULTs and dyld's amfiFlags() becomes 0.
+            // Ask the host with a host out-pointer and record the 8-byte answer as a guest write.
+            Stop::Syscall { num, args } if num == 381 && args[1] == 0x5a && b.is_mapped(args[2]) => {
+                let inflags = b.read_u64(args[2]);
+                let out_ptr = b.read_u64(args[2] + 8);
+                let mut out: u64 = 0;
+                #[repr(C)] struct AmfiArgs { i: u64, o: *mut u64 }
+                let mut a = AmfiArgs { i: inflags, o: &mut out };
+                unsafe extern "C" { fn __mac_syscall(p: *const std::ffi::c_char, c: i32, a: *mut std::ffi::c_void) -> i32; }
+                let r = unsafe { __mac_syscall(c"AMFI".as_ptr(), 0x5a, (&mut a as *mut AmfiArgs).cast()) };
+                eprintln!("[m47] amfi policy_resident={:?}", String::from_utf8_lossy(&b.read_va_prefix(args[0], 5)));
+                eprintln!("[probe] AMFI dyld policy in={inflags:#x} r={r} out={out:#x} out_ptr={out_ptr:#x}");
+                let writes = vec![Region { ipa: out_ptr, bytes: out.to_le_bytes().to_vec() }];
+                w.append(&Event::Syscall { num, args, ret: 0, ret1: 0, err: false, writes: writes.clone(), thread }).map_err(|e| format!("append amfi: {e}"))?; count += 1;
+                b.apply_and_return(0, false, &writes);
+            }
+            // PROBE SCRATCH: madvise(addr, len, MADV_ZERO=11) zeroes the range — the kernel WRITES
+            // guest memory past any diff window. Zero it here and record the zeros instead.
+            // PROBE SCRATCH (causation test): MADV_FREE_REUSABLE (7) / MADV_FREE_REUSE (8) as
+            // no-ops — a kernel that never reclaims is a valid kernel. Not forwarded.
+            Stop::Syscall { num, args } if num == 75 && (args[2] == 7 || args[2] == 8) && std::env::var_os("PROBE_NOREUSABLE").is_some() => {
+                eprintln!("[probe] madvise({:#x}, {:#x}, {}) not forwarded (no-op)", args[0], args[1], args[2]);
+                w.append(&Event::Syscall { num, args, ret: 0, ret1: 0, err: false, writes: vec![], thread }).map_err(|e| format!("append madv: {e}"))?; count += 1;
+                b.apply_and_return(0, false, &[]);
+            }
+            Stop::Syscall { num, args } if num == 75 && args[2] == 11 && b.is_mapped(args[0]) => {
+                eprintln!("[probe] MADV_ZERO addr={:#x} len={:#x} (emulated as a recorded zero write)", args[0], args[1]);
+                let writes = vec![Region { ipa: args[0], bytes: vec![0u8; args[1] as usize] }];
+                w.append(&Event::Syscall { num, args, ret: 0, ret1: 0, err: false, writes: writes.clone(), thread }).map_err(|e| format!("append madv_zero: {e}"))?; count += 1;
+                b.apply_and_return(0, false, &writes);
+            }
             // mach_vm_allocate / mach_vm_map: allocate anonymous GUEST memory (never forward). The
             // kernel writes the chosen address into *args[1]; we allocate a deterministic guest IPA
             // and store it there, returning KERN_SUCCESS.
@@ -1276,6 +1316,20 @@ fn record_box(mut b: Box_, trace_path: &Path) -> Result<RecordSummary, String> {
                 // successful close has already retired its slot — forward_and_diff owns both halves
                 // of the fd contract so no caller has to remember the second one.
                 let (ret, ret1, err, mut writes) = b.forward_and_diff(num, args);
+                // M47 t0 SCRATCH (never committed): the madvise / __mac_syscall census line.
+                if num == 75 || num == 381 {
+                    let cstr = |va: u64| {
+                        let v = b.read_va_prefix(va, 64);
+                        let n = v.iter().position(|&c| c == 0).unwrap_or(v.len());
+                        String::from_utf8_lossy(&v[..n]).into_owned()
+                    };
+                    let (policy, op) = if num == 381 {
+                        let p = b.read_va_prefix(args[2].wrapping_add(16), 8);
+                        (cstr(args[0]), if p.len() == 8 { cstr(u64::from_le_bytes(p.try_into().unwrap())) } else { String::from("<no arg+16>") })
+                    } else { (String::new(), String::new()) };
+                    eprintln!("[m47] num={num} args=[{:#x},{:#x},{:#x}] policy={policy:?} op={op:?} ret={ret:#x} err={err} writes={}",
+                        args[0], args[1], args[2], writes.len());
+                }
                 // M38: pipe's write end. Gated on the row, not on `ret1 != 0`, so the guest's x1
                 // is touched for exactly the rows replay touches it for.
                 if retrace_arch::returns_fd_pair(num) { b.set_ret1(ret1); }
