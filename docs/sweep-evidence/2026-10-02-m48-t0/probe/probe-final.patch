+impl Box_ {
+    /// Diagnostic: per-backing FNV hashes, one line each.
+    pub fn probe_mem_hashes(&self) -> String {
+        fn fnv(b: &[u8]) -> u64 { let mut h = 0xcbf29ce484222325u64; for &x in b { h ^= x as u64; h = h.wrapping_mul(0x100000001b3); } h }
+        let mut v: Vec<(u64, usize, u64)> = self.backings.iter().map(|bk| (bk.ipa, bk.len, fnv(unsafe { std::slice::from_raw_parts(bk.host, bk.len) }))).collect();
+        v.sort();
