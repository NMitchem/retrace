new file mode 100644
index 0000000..fe7c0d4
--- /dev/null
+++ b/crates/retrace-box/src/probe.rs
@@ -0,0 +1,434 @@
+//! M48 SCRATCH PROBE ONLY. Crude stubs for kevent / psynch / SPRR so node can be walked past each
+//! wall. Never lands. Everything here is box state driven by the guest's own syscalls, so record
+//! and replay run it identically, but nothing is faithful beyond what the walk needed.
+use std::collections::BTreeMap;
+use crate::{thread, Box_};
+
+#[derive(Clone, Debug, Default)]
+pub struct Knote { pub ident: u64, pub filter: i16, pub flags: u16, pub fflags: u32, pub data: i64, pub udata: u64,
+                   pub active: bool, pub enabled: bool, pub seq: u64 }
+
+#[derive(Clone, Debug)]
+pub enum Wait {
+    Kevent { kq: u64, elist: u64, nev: u64, deadline: Option<u64> },
+    Cv { addr: u64, deadline: Option<u64>, seq: u64 },
+    Mtx { addr: u64 },
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct Probe {
+    pub kqs: BTreeMap<u64, Vec<Knote>>,
+    pub seq: u64,
+    pub waits: BTreeMap<usize, Wait>,
+    pub sprr: BTreeMap<usize, u64>,
+    pub jit: Vec<(u64, u64)>,
+    pub view_rw: bool,
+    pub toggles: u64,
+    pub flips: u64,
+    pub kevents: u64,
+    pub psynch: u64,
+    /// cv addr -> pending (unconsumed) signals with no waiter.
+    pub cv_prepost: BTreeMap<u64, u32>,
+    pub toggles_by_tid: BTreeMap<usize, u64>,
+    pub switch_flips: u64,
+    pub max_runnable: usize,
+}
+
+pub fn log_on() -> bool { std::env::var_os("RETRACE_PROBE").is_some() }
+
+const EV_ADD: u16 = 1; const EV_DELETE: u16 = 2; const EV_ENABLE: u16 = 4; const EV_DISABLE: u16 = 8;
+const EV_ONESHOT: u16 = 0x10; const EV_CLEAR: u16 = 0x20; const EV_RECEIPT: u16 = 0x40; const EV_ERROR: u16 = 0x4000;
+const NOTE_TRIGGER: u32 = 0x0100_0000;
+
+fn rd(b: &Box_, a: u64, n: usize) -> Option<Vec<u8>> { b.read_guest_checked(a, n) }
+fn u64le(v: &[u8], o: usize) -> u64 { u64::from_le_bytes(v[o..o + 8].try_into().unwrap()) }
+
+impl Box_ {
+    fn probe_tid(&self) -> usize { self.threads.current() }
+
+    /// Ticks per ns on the guest timebase: 24 MHz (125/3 ns per tick).
+    fn probe_deadline(&self, sec: i64, nsec: i64) -> u64 {
+        let ns = (sec as i128) * 1_000_000_000 + nsec as i128;
+        let ticks = (ns.max(0) as u128 * 3 / 125) as u64;
+        self.now_guest_pub().wrapping_add(ticks)
+    }
+
+    fn write_events(&mut self, kq: u64, elist: u64, nev: u64) -> u64 {
+        let mut kn = self.probe.kqs.remove(&kq).unwrap_or_default();
+        let mut idx: Vec<usize> = (0..kn.len()).filter(|&i| kn[i].active && kn[i].enabled).collect();
+        idx.sort_by_key(|&i| kn[i].seq);
+        idx.truncate(nev as usize);
+        let mut out = Vec::new();
+        let mut del = Vec::new();
+        for &i in &idx {
+            let k = &mut kn[i];
+            let mut e = Vec::with_capacity(32);
+            e.extend_from_slice(&k.ident.to_le_bytes());
+            e.extend_from_slice(&k.filter.to_le_bytes());
+            e.extend_from_slice(&k.flags.to_le_bytes());
+            e.extend_from_slice(&k.fflags.to_le_bytes());
+            e.extend_from_slice(&k.data.to_le_bytes());
+            e.extend_from_slice(&k.udata.to_le_bytes());
+            out.push(e);
+            if k.flags & EV_CLEAR != 0 || k.filter == -10 && k.flags & EV_CLEAR != 0 {
+                k.active = false; if k.filter == -10 { k.fflags = 0; k.data = 0; }
+            }
+            if k.flags & EV_ONESHOT != 0 { del.push(i); }
+        }
+        del.sort(); for i in del.into_iter().rev() { kn.remove(i); }
+        self.probe.kqs.insert(kq, kn);
+        let n = out.len() as u64;
+        for (j, e) in out.into_iter().enumerate() { self.write_guest(elist + 32 * j as u64, &e); }
+        if log_on() && n > 0 { eprintln!("[probe] kevent deliver kq={kq} n={n}"); }
+        n
+    }
+
+    /// Wake the blocked kevent waiters of `kq` that now have events: deliver into their saved ctx.
+    fn wake_kq(&mut self, kq: u64) {
+        let ws: Vec<(usize, u64, u64)> = self.probe.waits.iter().filter_map(|(&t, w)| match w {
+            Wait::Kevent { kq: k, elist, nev, .. } if *k == kq => Some((t, *elist, *nev)), _ => None }).collect();
+        for (t, elist, nev) in ws {
+            let n = self.write_events(kq, elist, nev);
+            if n == 0 { continue; }
+            self.probe.waits.remove(&t);
+            self.probe_finish(t, n, false);
+            if log_on() { eprintln!("[probe] kevent wake tid={t} kq={kq} n={n}"); }
+        }
+    }
+
+    /// Make `t` runnable with x0 = rc (carry = err).
+    fn probe_finish(&mut self, t: usize, rc: u64, err: bool) {
+        self.threads.wake_probe(t);
+        if t == self.threads.current() {
+            self.vcpu.set_reg(hv_sys::reg::x(0), rc).unwrap();
+            let c = self.vcpu.get_reg(hv_sys::reg::CPSR).unwrap();
+            let c = (c & !retrace_arch::PSTATE_C) | if err { retrace_arch::PSTATE_C } else { 0 };
+            self.vcpu.set_reg(hv_sys::reg::CPSR, c).unwrap();
+        } else {
+            let ctx = self.threads.ctx_mut(t);
+            ctx.regs.x[0] = rc;
+            ctx.regs.cpsr = (ctx.regs.cpsr & !retrace_arch::PSTATE_C) | if err { retrace_arch::PSTATE_C } else { 0 };
+        }
+    }
+
+    /// kevent(kq, changes, nchanges, events, nevents, timeout). Returns (rc, err).
+    pub fn probe_kevent(&mut self, a: [u64; 8]) -> (u64, bool) {
+        self.probe.kevents += 1;
+        let (kq, ch, nch, el, nev, to) = (a[0], a[1], a[2], a[3], a[4], a[5]);
+        let tid = self.probe_tid();
+        let timeout = if to == 0 { None } else {
+            let t = rd(self, to, 16).expect("kevent timeout unmapped");
+            Some((u64le(&t, 0) as i64, u64le(&t, 8) as i64)) };
+        let chb = if nch > 0 { rd(self, ch, 32 * nch as usize).expect("kevent changes unmapped") } else { vec![] };
+        let mut errs: Vec<Vec<u8>> = Vec::new();
+        let mut kn = self.probe.kqs.remove(&kq).unwrap_or_default();
+        let mut activated = false;
+        for i in 0..nch as usize {
+            let c = &chb[32 * i..32 * i + 32];
+            let ident = u64le(c, 0);
+            let filter = i16::from_le_bytes([c[8], c[9]]);
+            let flags = u16::from_le_bytes([c[10], c[11]]);
+            let fflags = u32::from_le_bytes(c[12..16].try_into().unwrap());
+            let data = u64le(c, 16) as i64; let udata = u64le(c, 24);
+            if log_on() { eprintln!("[probe] kevent#{} tid={tid} kq={kq} change ident={ident:#x} filter={filter} flags={flags:#x} fflags={fflags:#x} data={data:#x} udata={udata:#x} nev={nev} timeout={timeout:?}", self.probe.kevents); }
+            if !matches!(filter, -10 | -1 | -2) {
+                panic!("[probe] kevent: unmodelled filter {filter} (ident {ident:#x} flags {flags:#x} fflags {fflags:#x}) kq={kq} tid={tid}");
+            }
+            let pos = kn.iter().position(|k| k.ident == ident && k.filter == filter);
+            if flags & EV_DELETE != 0 {
+                match pos { Some(p) => { kn.remove(p); } None => {
+                    let mut e = c.to_vec(); e[10..12].copy_from_slice(&(flags | EV_ERROR).to_le_bytes());
+                    e[16..24].copy_from_slice(&2u64.to_le_bytes()); errs.push(e); } }
+                continue;
+            }
+            let p = match pos {
+                Some(p) => p,
+                None if flags & EV_ADD != 0 => {
+                    kn.push(Knote { ident, filter, flags: flags & !(EV_ENABLE | EV_DISABLE | EV_RECEIPT), fflags: 0, data: 0, udata, active: false, enabled: true, seq: 0 });
+                    kn.len() - 1
+                }
+                None => {
+                    let mut e = c.to_vec(); e[10..12].copy_from_slice(&(flags | EV_ERROR).to_le_bytes());
+                    e[16..24].copy_from_slice(&2u64.to_le_bytes()); errs.push(e); continue;
+                }
+            };
+            let k = &mut kn[p];
+            k.udata = udata;
+            if flags & EV_ADD != 0 { k.flags = flags & !(EV_ENABLE | EV_DISABLE | EV_RECEIPT); }
+            if flags & EV_DISABLE != 0 { k.enabled = false; }
+            if flags & EV_ENABLE != 0 { k.enabled = true; }
+            match filter {
+                -10 => {
+                    let ffl = fflags & 0x00ff_ffff;
+                    match fflags & 0xc000_0000 { 0x4000_0000 => k.fflags &= ffl, 0x8000_0000 => k.fflags |= ffl, 0xc000_0000 => k.fflags = ffl, _ => {} }
+                    if fflags & NOTE_TRIGGER != 0 && !k.active { self.probe.seq += 1; k.seq = self.probe.seq; k.active = true; activated = true; }
+                }
+                -2 => { // EVFILT_WRITE: crude, always writable
+                    if !k.active { self.probe.seq += 1; k.seq = self.probe.seq; k.active = true; k.data = 0x4000; }
+                }
+                _ => { // EVFILT_READ: crude, never ready (logged)
+                }
+            }
+            if flags & EV_RECEIPT != 0 {
+                let mut e = c.to_vec(); e[10..12].copy_from_slice(&(flags | EV_ERROR).to_le_bytes());
+                e[16..24].copy_from_slice(&0u64.to_le_bytes()); errs.push(e);
+            }
+        }
+        self.probe.kqs.insert(kq, kn);
+        if !errs.is_empty() {
+            assert!(nev as usize >= errs.len(), "[probe] kevent error events exceed nevents");
+            for (j, e) in errs.iter().enumerate() { self.write_guest(el + 32 * j as u64, e); }
+            if log_on() { eprintln!("[probe] kevent#{} returns {} error/receipt events", self.probe.kevents, errs.len()); }
+            return (errs.len() as u64, false);
+        }
+        if activated { self.wake_kq(kq); }
+        let n = self.write_events(kq, el, nev);
+        if log_on() { eprintln!("[probe] kevent#{} call tid={tid} kq={kq} nch={nch} nev={nev} timeout={timeout:?} -> immediate n={n}", self.probe.kevents); }
+        if n > 0 || nev == 0 { return (n, false); }
+        match timeout {
+            Some((0, 0)) => (0, false),
+            t => {
+                let deadline = t.map(|(s, ns)| self.probe_deadline(s, ns));
+                if log_on() { eprintln!("[probe] kevent#{} BLOCK tid={tid} kq={kq} timeout={t:?} deadline={deadline:?} now={:#x}", self.probe.kevents, self.now_guest_pub()); }
+                self.probe.waits.insert(tid, Wait::Kevent { kq, elist: el, nev, deadline });
+                self.threads.block(thread::BlockReason::Probe);
+                (0, false)
+            }
+        }
+    }
+
+    /// Earliest probe deadline (kevent timeouts, timed cvwaits).
+    pub fn probe_earliest_deadline(&self) -> Option<u64> {
+        self.probe.waits.values().filter_map(|w| match w {
+            Wait::Kevent { deadline, .. } | Wait::Cv { deadline, .. } => *deadline, _ => None }).min()
+    }
+
+    /// Wake every probe waiter whose deadline is reached.
+    pub fn probe_fire_deadlines(&mut self) {
+        if !self.probe.waits.values().any(|w| matches!(w, Wait::Kevent { deadline: Some(_), .. } | Wait::Cv { deadline: Some(_), .. })) { return; }
+        let now = self.now_guest_pub();
+        let due: Vec<usize> = self.probe.waits.iter().filter_map(|(&t, w)| match w {
+            Wait::Kevent { deadline: Some(d), .. } | Wait::Cv { deadline: Some(d), .. } if *d <= now => Some(t), _ => None }).collect();
+        for t in due {
+            let w = self.probe.waits.remove(&t).unwrap();
+            match w {
+                Wait::Kevent { .. } => { if log_on() { eprintln!("[probe] kevent timeout tid={t}"); } self.probe_finish(t, 0, false) }
+                Wait::Cv { addr, .. } => { if log_on() { eprintln!("[probe] cvwait timeout tid={t} cv={addr:#x}"); } self.probe_finish(t, 60, true) } // ETIMEDOUT
+                _ => unreachable!(),
+            }
+        }
+    }
+
+    // ---------------- psynch (crude) ----------------
+
+    /// __psynch_cvwait(cv, cvlsgen, cvugen, mutex, mugen, flags, sec, nsec)
+    pub fn probe_cvwait(&mut self, a: [u64; 8]) -> (u64, bool) {
+        self.probe.psynch += 1;
+        let tid = self.probe_tid();
+        if log_on() { eprintln!("[probe] psynch#{} cvwait tid={tid} cv={:#x} lsgen={:#x} ugen={:#x} mutex={:#x} mugen={:#x} flags={:#x} sec={} nsec={}", self.probe.psynch, a[0], a[1], a[2], a[3], a[4], a[5], a[6] as i64, a[7] as u32); }
+        if a[3] != 0 { self.probe_wake_mtx(a[3]); }
+        if let Some(c) = self.probe.cv_prepost.get_mut(&a[0]) {
+            if *c > 0 { *c -= 1; if log_on() { eprintln!("[probe] cvwait consumes prepost"); } return (0x100, false); }
+        }
+        let deadline = if a[6] != 0 || a[7] as u32 != 0 { Some(self.probe_deadline(a[6] as i64, a[7] as u32 as i64)) } else { None };
+        self.probe.seq += 1;
+        self.probe.waits.insert(tid, Wait::Cv { addr: a[0], deadline, seq: self.probe.seq });
+        self.threads.block(thread::BlockReason::Probe);
+        (0, false)
+    }
+
+    fn probe_cv_waiters(&self, cv: u64) -> Vec<usize> {
+        let mut v: Vec<(u64, usize)> = self.probe.waits.iter().filter_map(|(&t, w)| match w {
+            Wait::Cv { addr, seq, .. } if *addr == cv => Some((*seq, t)), _ => None }).collect();
+        v.sort(); v.into_iter().map(|(_, t)| t).collect()
+    }
+
+    /// __psynch_cvsignal(cv, cvlsgen, cvugen, thread_port, mutex, mugen, tid, flags)
+    pub fn probe_cvsignal(&mut self, a: [u64; 8]) -> (u64, bool) {
+        self.probe.psynch += 1;
+        if log_on() { eprintln!("[probe] psynch#{} cvsignal tid={} cv={:#x} lsgen={:#x} ugen={:#x} port={:#x} mutex={:#x} mugen={:#x} thr={:#x} flags={:#x}", self.probe.psynch, self.probe_tid(), a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]); }
+        assert!(a[3] as u32 == 0, "[probe] targeted cvsignal (thread port {:#x})", a[3]);
+        let w = self.probe_cv_waiters(a[0]);
+        if let Some(&t) = w.first() {
+            self.probe.waits.remove(&t);
+            self.probe_finish(t, 0, false);
+            (0x100, false)
+        } else {
+            *self.probe.cv_prepost.entry(a[0]).or_default() += 1;
+            if log_on() { eprintln!("[probe] cvsignal: no waiter, prepost"); }
+            (0, false)
+        }
+    }
+
+    /// __psynch_cvbroad(cv, cvlsgen, cvudgen, flags, mutex, mugen, tid)
+    pub fn probe_cvbroad(&mut self, a: [u64; 8]) -> (u64, bool) {
+        self.probe.psynch += 1;
+        let w = self.probe_cv_waiters(a[0]);
+        if log_on() { eprintln!("[probe] psynch#{} cvbroad tid={} cv={:#x} lsgen={:#x} udgen={:#x} flags={:#x} mutex={:#x} mugen={:#x} waiters={}", self.probe.psynch, self.probe_tid(), a[0], a[1], a[2], a[3], a[4], a[5], w.len()); }
+        for &t in &w { self.probe.waits.remove(&t); self.probe_finish(t, 0, false); }
+        ((w.len() as u64) * 0x100, false)
+    }
+
+    /// __psynch_mutexwait(mutex, mgen, ugen, tid, flags)
+    pub fn probe_mutexwait(&mut self, a: [u64; 8]) -> (u64, bool) {
+        self.probe.psynch += 1;
+        let tid = self.probe_tid();
+        if log_on() { eprintln!("[probe] psynch#{} mutexwait tid={tid} m={:#x} mgen={:#x} ugen={:#x} thr={:#x} flags={:#x}", self.probe.psynch, a[0], a[1], a[2], a[3], a[4]); }
+        self.probe.waits.insert(tid, Wait::Mtx { addr: a[0] });
+        self.threads.block(thread::BlockReason::Probe);
+        (a[1], false)
+    }
+
+    fn probe_wake_mtx(&mut self, m: u64) -> usize {
+        let w: Vec<usize> = self.probe.waits.iter().filter_map(|(&t, w)| match w { Wait::Mtx { addr } if *addr == m => Some(t), _ => None }).collect();
+        for &t in &w { self.probe.waits.remove(&t); self.probe_finish(t, 0, false); }
+        w.len()
+    }
+
+    /// __psynch_mutexdrop(mutex, mgen, ugen, tid, flags)
+    pub fn probe_mutexdrop(&mut self, a: [u64; 8]) -> (u64, bool) {
+        self.probe.psynch += 1;
+        let n = self.probe_wake_mtx(a[0]);
+        if log_on() { eprintln!("[probe] psynch#{} mutexdrop tid={} m={:#x} mgen={:#x} ugen={:#x} thr={:#x} flags={:#x} woke={n}", self.probe.psynch, self.probe_tid(), a[0], a[1], a[2], a[3], a[4]); }
+        (0, false)
+    }
+
+    /// __psynch_cvclrprepost(cv, cvgen, cvugen, cvsgen, prepocnt, preposeq, flags)
+    pub fn probe_cvclrprepost(&mut self, a: [u64; 8]) -> (u64, bool) {
+        self.probe.psynch += 1;
+        if log_on() { eprintln!("[probe] psynch#{} cvclrprepost tid={} cv={:#x} {:#x} {:#x} {:#x} {:#x} {:#x} {:#x}", self.probe.psynch, self.probe_tid(), a[0], a[1], a[2], a[3], a[4], a[5], a[6]); }
+        self.probe.cv_prepost.remove(&a[0]);
+        (0, false)
+    }
+
+    pub fn probe_dispatch(&mut self, num: u64, a: [u64; 8]) -> Option<(u64, bool)> {
+        Some(match num {
+            363 => self.probe_kevent(a),
+            305 => self.probe_cvwait(a),
+            304 => self.probe_cvsignal(a),
+            303 => self.probe_cvbroad(a),
+            301 => self.probe_mutexwait(a),
+            302 => self.probe_mutexdrop(a),
+            312 => self.probe_cvclrprepost(a),
+            _ => return None,
+        })
+    }
+}
