+impl Box_ {
+    /// Diagnostic: FNV hash of live regs (GPR, SIMD, FPCR/FPSR) and of the main stack.
+    pub fn probe_state_hash(&self) -> String {
+        fn fnv(h: &mut u64, b: &[u8]) { for &x in b { *h ^= x as u64; *h = h.wrapping_mul(0x100000001b3); } }
+        let mut hr = 0xcbf29ce484222325u64;
+        let r = self.regs_snapshot();
+        for x in r.x { fnv(&mut hr, &x.to_le_bytes()); }
+        fnv(&mut hr, &r.pc.to_le_bytes()); fnv(&mut hr, &r.sp_el0.to_le_bytes()); fnv(&mut hr, &r.cpsr.to_le_bytes());
+        let mut hf = 0xcbf29ce484222325u64;
+        for i in 0..32u32 { fnv(&mut hf, &self.vcpu.get_simd(hv_sys::simd::q(i)).unwrap().to_le_bytes()); }
+        fnv(&mut hf, &self.vcpu.get_reg(hv_sys::reg::FPCR).unwrap().to_le_bytes());
+        fnv(&mut hf, &self.vcpu.get_reg(hv_sys::reg::FPSR).unwrap().to_le_bytes());
+        let mut hm = 0xcbf29ce484222325u64;
+        if let Some(m) = self.read_guest_checked(0x27c0000, 0x40000) { fnv(&mut hm, &m); }
+        format!("r={hr:016x} f={hf:016x} m={hm:016x} pc={:#x}", r.pc)
+    }
+}
