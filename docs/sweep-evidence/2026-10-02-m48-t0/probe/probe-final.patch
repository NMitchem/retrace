+// ---------------- JIT write-protect (crude J1) ----------------
+impl Box_ {
+    fn sprr_vals(&self) -> (u64, u64) {
+        let we = u64::from_le_bytes(self.read_guest(crate::COMMPAGE_IPA + 0x110, 8).try_into().unwrap());
+        let pr = u64::from_le_bytes(self.read_guest(crate::COMMPAGE_IPA + 0x118, 8).try_into().unwrap());
+        (we, pr)
+    }
+
+    /// Called from try_emulate_undef_mrs for `msr S3_6_C15_C1_5, Xt` (value already read).
+    pub fn probe_sprr_write(&mut self, v: u64, pc: u64) {
+        let (we, pr) = self.sprr_vals();
+        assert!(v == we || v == pr, "[probe] msr S3_6_C15_C1_5 value {v:#x} at pc {pc:#x}: neither +0x110 {we:#x} nor +0x118 {pr:#x}");
+        let tid = self.threads.current();
+        self.probe.sprr.insert(tid, v);
+        self.probe.toggles += 1;
+        *self.probe.toggles_by_tid.entry(tid).or_default() += 1;
+        if log_on() && (self.probe.toggles <= 20 || self.probe.toggles % 1000 == 0) {
+            eprintln!("[probe] sprr write #{} tid={tid} {} pc={pc:#x}", self.probe.toggles, if v == we { "RW" } else { "RX" });
+        }
+        self.probe_apply_view(false);
+    }
+
+    pub fn probe_sprr_read(&self) -> u64 { *self.probe.sprr.get(&self.threads.current()).unwrap_or(&0) }
+
+    fn probe_want_rw(&self) -> bool {
+        let v = self.probe_sprr_read();
+        v != 0 && v == self.sprr_vals().0
+    }
+
+    /// Stamp every MAP_JIT range (minus PROT_NONE extents) with the running thread's view.
+    pub fn probe_apply_view(&mut self, force: bool) {
+        if self.probe.jit.is_empty() { return; }
+        let rw = self.probe_want_rw();
+        if !force && rw == self.probe.view_rw { return; }
+        self.probe.view_rw = rw;
+        let attr = if rw { crate::ATTR_DATA } else { crate::ATTR_CODE };
+        let ranges = self.probe.jit.clone();
+        for (s, l) in ranges {
+            // subtract noaccess extents
+            let mut cur = s; let end = s + l;
+            let mut na: Vec<(u64, u64)> = self.noaccess.iter().copied().filter(|&(a, b)| a < end && a + b > s).collect();
+            na.sort();
+            for (a, b) in na {
+                if a > cur { self.set_region_attr(cur, a - cur, attr); }
+                cur = cur.max(a + b);
+            }
+            if cur < end { self.set_region_attr(cur, end - cur, attr); }
+        }
+        self.flush_guest_tlb();
+        self.probe.flips += 1;
+        if log_on() && (self.probe.flips <= 20 || self.probe.flips % 1000 == 0) {
+            eprintln!("[probe] view flip #{} -> {} (tid {})", self.probe.flips, if rw { "RW" } else { "RX" }, self.threads.current());
+        }
+    }
+
+    pub fn probe_note_mmap(&mut self, ipa: u64, len: u64, prot: u64, flags: u64) {
+        if flags & 0x800 != 0 {
+            if log_on() { eprintln!("[probe] MAP_JIT mmap ipa={ipa:#x} len={len:#x} prot={prot:#x} flags={flags:#x}"); }
+            self.probe.jit.push((ipa, len));
+            self.probe_apply_view(true);
+        } else if prot & 4 != 0 && log_on() {
+            eprintln!("[probe] non-JIT exec mmap ipa={ipa:#x} len={len:#x} prot={prot:#x} flags={flags:#x}");
+        }
+    }
+
+    pub fn probe_note_mprotect(&mut self, ipa: u64, len: u64, prot: u64) {
+        if self.probe.jit.iter().any(|&(s, l)| ipa < s + l && s < ipa + len) {
+            if log_on() { eprintln!("[probe] mprotect over MAP_JIT ipa={ipa:#x} len={len:#x} prot={prot:#x}"); }
+            self.probe_apply_view(true);
+        }
+    }
+
+    pub fn probe_note_munmap(&mut self, ipa: u64, len: u64) {
+        if self.probe.jit.iter().any(|&(s, l)| ipa < s + l && s < ipa + len) {
+            if log_on() { eprintln!("[probe] munmap over MAP_JIT ipa={ipa:#x} len={len:#x}"); }
+        }
+    }
+}
