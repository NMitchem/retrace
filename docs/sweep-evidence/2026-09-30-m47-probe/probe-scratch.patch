+            // PROBE SCRATCH (not for main): __mac_syscall("AMFI", 0x5a, {inFlags, &outFlags}) —
+            // the kernel writes through the NESTED outFlags pointer, a guest VA that is unmapped in
+            // retrace's own space, so the generic forward EFAULTs and dyld's amfiFlags() becomes 0.
+            // Ask the host with a host out-pointer and record the 8-byte answer as a guest write.
+            Stop::Syscall { num, args } if num == 381 && args[1] == 0x5a && b.is_mapped(args[2]) => {
+                let inflags = b.read_u64(args[2]);
+                let out_ptr = b.read_u64(args[2] + 8);
+                let mut out: u64 = 0;
+                #[repr(C)] struct AmfiArgs { i: u64, o: *mut u64 }
+                let mut a = AmfiArgs { i: inflags, o: &mut out };
+                unsafe extern "C" { fn __mac_syscall(p: *const std::ffi::c_char, c: i32, a: *mut std::ffi::c_void) -> i32; }
+                let r = unsafe { __mac_syscall(c"AMFI".as_ptr(), 0x5a, (&mut a as *mut AmfiArgs).cast()) };
+                eprintln!("[probe] AMFI dyld policy in={inflags:#x} r={r} out={out:#x} out_ptr={out_ptr:#x}");
+                let writes = vec![Region { ipa: out_ptr, bytes: out.to_le_bytes().to_vec() }];
+                w.append(&Event::Syscall { num, args, ret: 0, ret1: 0, err: false, writes: writes.clone(), thread }).map_err(|e| format!("append amfi: {e}"))?; count += 1;
+                b.apply_and_return(0, false, &writes);
+            }
