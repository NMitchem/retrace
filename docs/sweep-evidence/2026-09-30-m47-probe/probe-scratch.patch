+            // PROBE SCRATCH (causation test): MADV_FREE_REUSABLE (7) / MADV_FREE_REUSE (8) as
+            // no-ops — a kernel that never reclaims is a valid kernel. Not forwarded.
+            Stop::Syscall { num, args } if num == 75 && (args[2] == 7 || args[2] == 8) && std::env::var_os("PROBE_NOREUSABLE").is_some() => {
+                eprintln!("[probe] madvise({:#x}, {:#x}, {}) not forwarded (no-op)", args[0], args[1], args[2]);
+                w.append(&Event::Syscall { num, args, ret: 0, ret1: 0, err: false, writes: vec![], thread }).map_err(|e| format!("append madv: {e}"))?; count += 1;
+                b.apply_and_return(0, false, &[]);
+            }
+            Stop::Syscall { num, args } if num == 75 && args[2] == 11 && b.is_mapped(args[0]) => {
+                eprintln!("[probe] MADV_ZERO addr={:#x} len={:#x} (emulated as a recorded zero write)", args[0], args[1]);
+                let writes = vec![Region { ipa: args[0], bytes: vec![0u8; args[1] as usize] }];
+                w.append(&Event::Syscall { num, args, ret: 0, ret1: 0, err: false, writes: writes.clone(), thread }).map_err(|e| format!("append madv_zero: {e}"))?; count += 1;
+                b.apply_and_return(0, false, &writes);
+            }
